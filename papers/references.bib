@ARTICLE{Leong2019-ky,
  title     = "Neurocomputational mechanisms underlying motivated seeing",
  author    = "Leong, Yuan Chang and Hughes, Brent L and Wang, Yiyu and Zaki,
               Jamil",
  journal   = "Nat. Hum. Behav.",
  publisher = "Springer Science and Business Media LLC",
  volume    =  3,
  number    =  9,
  pages     = "962--973",
  abstract  = "People tend to believe that their perceptions are veridical
               representations of the world, but also commonly report perceiving
