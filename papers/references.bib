  journal   = "J. Polit. Econ.",
  publisher = "University of Chicago Press",
  volume    =  123,
  number    =  1,
  pages     = "215--260",
  abstract  = "We model demand for noninstrumental information, drawing on the
               idea that people derive entertainment utility from suspense and
               surprise. A period has more suspense if the variance of the next
               period’s beliefs is greater. A period has more surprise if the
               current belief is further from the last period’s belief. Under
