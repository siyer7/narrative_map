  language  = "en"
}

@ARTICLE{Levenstein2024-pa,
  title       = "Sequential predictive learning is a unifying theory for
                 hippocampal representation and replay",
  author      = "Levenstein, Daniel and Efremov, Aleksei and Eyono, Roy Henha
