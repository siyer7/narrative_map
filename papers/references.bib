  language  = "en"
}

@ARTICLE{Gungi2026-fg,
  title       = "Building goal-directed cognitive graphs",
  author      = "Gungi, Adithya and Sepúlveda, Pradyumna and Aitsahalia, Ines F
                 and Blanco-Pozo, Marta and Iigaya, Kiyohito",
  journal     = "bioRxivorg",
  institution = "bioRxiv",
  abstract    = "Flexible behavior requires building internal structured models
                 from experience to support goal-directed action. Although
                 environmental transition statistics accumulate gradually, how
                 they are used to construct a compact goal-directed graph
                 remains unclear. We introduce the Sparse Cognitive Graph (SCG),
