              findings suggests that neural timescales are a dynamic feature of
              the cerebral cortex that change to meet task demands.",
  month    =  jul,
  year     =  2025,
  language = "en"
}

@ARTICLE{Nguyen2024-ay,
  title     = "Modeling human activity comprehension at human scale: prediction,
