@ARTICLE{Pacheco-Estefan2026-qo,
  title     = "Representational dynamics during extinction of fear memories in
               the human brain",
  author    = "Pacheco-Estefan, Daniel and Bouyeure, Antoine and Jacob, George
               and Fellner, Marie-Christin and Lehongre, Katia and Lambrecq,
